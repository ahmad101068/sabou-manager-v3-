     }
 
     private fun ensureFixtureSessionLoggedOut() {
-        val hasSession = runBlocking { app.container.securityRepository.currentUser.first() != null }
+        val security = app.container.securityRepository
+        val hasSession = runBlocking { security.currentUser.first() != null }
         if (hasSession) {
-            runBlocking { app.container.securityRepository.logout() }
+            // Direct repository logout is a fixture operation, not a production UI transition.
+            // Dispose the active Compose graph first so session-bound collectors cannot re-enter
+            // authorization after the session row is cleared, then recreate the real activity.
+            composeRule.activityRule.scenario.onActivity { activity -> activity.setContent {} }
+            composeRule.waitForIdle()
+            runBlocking { security.logout() }
+            composeRule.activityRule.scenario.recreate()
         }
         waitForLoggedOutGraph()
     }
