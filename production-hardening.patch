+        assertEquals((1L..PARALLEL_WRITERS.toLong()).toSet(), rows.map { it.revision }.toSet())
+        assertEquals(PARALLEL_WRITERS.toLong(), scalar("SELECT COUNT(*) FROM audit_logs WHERE entityType='CONCURRENCY_PROBE'"))
