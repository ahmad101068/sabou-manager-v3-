diff --git a/app/src/main/java/ir/restaurant/management/data/security/SessionAuthorizer.kt b/app/src/main/java/ir/restaurant/management/data/security/SessionAuthorizer.kt
index 3963d83..1fa7f88 100644
--- a/app/src/main/java/ir/restaurant/management/data/security/SessionAuthorizer.kt
+++ b/app/src/main/java/ir/restaurant/management/data/security/SessionAuthorizer.kt
@@ -1,6 +1,8 @@
 package ir.restaurant.management.data.security
 
+import ir.restaurant.management.core.GlobalId
 import ir.restaurant.management.data.db.AppDatabase
+import ir.restaurant.management.data.db.AuditLogEntity
 import ir.restaurant.management.domain.common.BusinessError
 import ir.restaurant.management.domain.common.BusinessRuleViolation
 import ir.restaurant.management.domain.security.AuthorizationService
@@ -39,7 +41,23 @@ class SessionAuthorizer(private val database: AppDatabase) : AuthorizationServic
     override suspend fun require(permission: Permission): AuthorizedActor {
         val actor = actorIdentity()
         val role = actor.role
-        if (!role.allows(permission)) throw AccessDeniedException(permission)
+        if (!role.allows(permission)) {
+            database.auditLogDao().insert(
+                AuditLogEntity(
+                    action = "ACCESS_DENIED",
+                    entityType = "SECURITY",
+                    entityId = actor.id,
+                    description = "رد دسترسی به مجوز ${permission.name}",
+                    actor = actor.displayName,
+                    createdAtEpochMillis = System.currentTimeMillis(),
+                    globalId = GlobalId.new().value,
+                    actorId = actor.id,
+                    reason = "PERMISSION_DENIED:${permission.name}",
+                    correlationId = "security:denied:${actor.id}:${permission.name}:${System.nanoTime()}",
+                ),
+            )
+            throw AccessDeniedException(permission)
+        }
         return actor
     }
 
