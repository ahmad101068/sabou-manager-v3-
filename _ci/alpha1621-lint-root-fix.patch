+++ b/app/src/main/java/ir/sabou/inventory/core/BigIntegerCompat.kt
@@ -0,0 +1,11 @@
+package ir.sabou.inventory.core
+
+import java.math.BigInteger
+
+/** API-23-safe equivalent of BigInteger.longValueExact without silent truncation. */
+fun BigInteger.toLongExactCompat(): Long {
+    require(this >= BigInteger.valueOf(Long.MIN_VALUE) && this <= BigInteger.valueOf(Long.MAX_VALUE)) {
+        "مقدار عددی از محدوده Long خارج است."
+    }
+    return toLong()
+}
