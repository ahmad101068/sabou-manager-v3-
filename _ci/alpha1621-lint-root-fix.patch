diff --git a/app/src/test/java/ir/sabou/inventory/core/BigIntegerCompatTest.kt b/app/src/test/java/ir/sabou/inventory/core/BigIntegerCompatTest.kt
new file mode 100644
index 0000000..7dcc342
--- /dev/null
+++ b/app/src/test/java/ir/sabou/inventory/core/BigIntegerCompatTest.kt
@@ -0,0 +1,20 @@
+package ir.sabou.inventory.core
+
+import java.math.BigInteger
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Test
+
+class BigIntegerCompatTest {
+    @Test fun exactBoundsAndNormalValues_arePreserved() {
+        assertEquals(Long.MIN_VALUE, BigInteger.valueOf(Long.MIN_VALUE).toLongExactCompat())
+        assertEquals(0L, BigInteger.ZERO.toLongExactCompat())
+        assertEquals(Long.MAX_VALUE, BigInteger.valueOf(Long.MAX_VALUE).toLongExactCompat())
+    }
+
+    @Test fun overflowAndUnderflow_areRejectedInsteadOfTruncated() {
+        assertThrows(IllegalArgumentException::class.java) { BigInteger.valueOf(Long.MAX_VALUE).add(BigInteger.ONE).toLongExactCompat() }
+        assertThrows(IllegalArgumentException::class.java) { BigInteger.valueOf(Long.MIN_VALUE).subtract(BigInteger.ONE).toLongExactCompat() }
+    }
+}
