diff --git a/app/src/main/java/ir/sabou/inventory/core/BigIntegerCompat.kt b/app/src/main/java/ir/sabou/inventory/core/BigIntegerCompat.kt
new file mode 100644
index 0000000..7757400
--- /dev/null
+++ b/app/src/main/java/ir/sabou/inventory/core/BigIntegerCompat.kt
@@ -0,0 +1,14 @@
+package ir.sabou.inventory.core
+
+import java.math.BigInteger
+
+private val LONG_MIN_BIG_INTEGER: BigInteger = BigInteger.valueOf(Long.MIN_VALUE)
+private val LONG_MAX_BIG_INTEGER: BigInteger = BigInteger.valueOf(Long.MAX_VALUE)
+
+/** API-23-safe equivalent of BigInteger.longValueExact(), preserving overflow failure semantics. */
+fun BigInteger.toLongExactCompat(): Long {
+    if (this < LONG_MIN_BIG_INTEGER || this > LONG_MAX_BIG_INTEGER) {
+        throw ArithmeticException("BigInteger out of long range")
+    }
+    return toLong()
+}
