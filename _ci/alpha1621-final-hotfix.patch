@@ -0,0 +1,61 @@
+package ir.sabou.inventory.data.repository
+
+import android.content.Context
+import androidx.room.withTransaction
+import androidx.test.core.app.ApplicationProvider
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import ir.sabou.inventory.data.db.AppDatabase
+import ir.sabou.inventory.domain.common.DocumentNumberType
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@RunWith(AndroidJUnit4::class)
+class DocumentNumberConcurrencyIntegrationTest {
+    private lateinit var database: AppDatabase
+    private lateinit var allocator: LocalDocumentNumberAllocator
+
+    @Before
+    fun setUp() {
+        database = AppDatabase.createInMemory(ApplicationProvider.getApplicationContext<Context>())
+        allocator = LocalDocumentNumberAllocator(database, clock = { 1_800_000_000_000L })
+    }
+
+    @After
+    fun tearDown() = database.close()
+
+    @Test
+    fun concurrentBusinessDocumentAllocation_neverDuplicatesSalesPurchaseAssetEmployeeOrCustomerCodes() = runBlocking {
+        val requiredTypes = listOf(
+            DocumentNumberType.SALES_INVOICE,
+            DocumentNumberType.PURCHASE,
+            DocumentNumberType.FIXED_ASSET,
+            DocumentNumberType.EMPLOYEE,
+            DocumentNumberType.CUSTOMER,
+        )
+
+        requiredTypes.forEach { type ->
+            val numbers = coroutineScope {
+                (1..16).map {
+                    async(Dispatchers.IO) {
+                        database.withTransaction { allocator.next(type) }
+                    }
+                }.awaitAll()
+            }
+
+            assertEquals("duplicate ${type.sequenceKey}", numbers.size, numbers.toSet().size)
+            assertTrue(numbers.all { it.startsWith("${type.prefix}-") })
+            assertEquals(
+                17L,
+                database.documentSequenceDao().nextValue(type.sequenceKey),
+            )
+        }
+    }
+}
