+package ir.sabou.inventory.core
+
+import java.math.BigInteger
+
+/**
+ * API-23-safe equivalent of BigInteger.longValueExact().
+ *
+ * Android only exposes BigInteger.longValueExact() from API 31. Converting first and
+ * round-tripping preserves the exact overflow contract without relying on that API.
+ */
+fun BigInteger.longValueExactCompat(): Long {
+    val converted = toLong()
+    if (BigInteger.valueOf(converted) != this) {
+        throw ArithmeticException("BigInteger out of long range")
+    }
+    return converted
+}
